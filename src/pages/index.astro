---
import '../styles/global.css';
import { App } from '../App';
---

<html lang="es" dir="ltr" data-theme="dark" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Security headers via meta (HTTPS enforced at hosting level) -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'sha256-y3voR0onDQsRJoLuMR/0arKd45/rwzuJDFtAH/x2e+Q=' 'sha256-npkW3W4Lwo60+u5BELqh0qRErxrvhwpDShcLBwx78yU=' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' https://cdn.vercel-insights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://vitals.vercel-insights.com; frame-src 'self' https://proassist-r1q6.onrender.com https://congreso-sena.vercel.app;"
    />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />

    <title>Lain Sthid Ramirez Rueda | Analista y Desarrollador de Software</title>
    <meta
      name="description"
      content="Lain Sthid Ramirez Rueda — Analista y Desarrollador de Software. Especialista en IA, Python, UI/UX y elicitación de requisitos. Disponible para proyectos."
    />
    <meta
      name="keywords"
      content="Lain Sthid Ramirez Rueda, analista de software, desarrollador full stack, SENA, Python, inteligencia artificial, automatización, UI/UX, elicitación de requisitos, portfolio, Colombia, desarrollador web, prompt engineering"
    />
    <meta name="author" content="Lain Sthid Ramirez Rueda" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="https://lainramirez.vercel.app/" />
    <!-- hreflang: single-URL SPA with client-side i18n — only x-default is correct per Google guidelines -->
    <link rel="alternate" hreflang="x-default" href="https://lainramirez.vercel.app/" />
    <!-- color-scheme: tells browser to style scrollbars, form controls and system UI accordingly -->
    <meta name="color-scheme" content="dark light" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon-180.png" />
    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicon-192.png" />
    <link rel="shortcut icon" href="/assets/img/favicon-32.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0B0D12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F2F3F8" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lainramirez.vercel.app/" />
    <meta property="og:title" content="Lain Sthid Ramirez Rueda | Analista y Desarrollador de Software" />
    <meta
      property="og:description"
      content="Analista y Desarrollador de Software graduado del SENA. Especialista en elicitación de requisitos, automatización con IA, Python y diseño UI/UX. Disponible para proyectos y colaboraciones."
    />
    <meta property="og:image" content="https://lainramirez.vercel.app/assets/img/og-image.jpg" />
    <meta property="og:image:width" content="1376" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:alt" content="Lain Sthid Ramirez Rueda - Portafolio y Tarjeta de Presentación" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Lain Ramirez — Portfolio" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Lain Sthid Ramirez Rueda | Portafolio" />
    <meta name="twitter:description" content="Especialista en IA, Python y Desarrollo Full-Stack." />
    <meta name="twitter:image" content="https://lainramirez.vercel.app/assets/img/og-image.jpg" />
    <meta name="twitter:image:alt" content="Lain Sthid Ramirez Rueda - Portafolio y Tarjeta de Presentación" />
    <meta name="twitter:creator" content="@lainramirez18" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Lain Sthid Ramirez Rueda",
        "url": "https://lainramirez.vercel.app/",
        "image": {
          "@type": "ImageObject",
          "url": "https://lainramirez.vercel.app/assets/img/profile.png",
          "width": 400,
          "height": 400
        },
        "jobTitle": "Analista y Desarrollador de Software",
        "description": "Analista y Desarrollador de Software graduado del SENA, especializado en elicitación de requisitos, automatización con IA, Python y diseño UI/UX. Disponible para proyectos y colaboraciones.",
        "nationality": {"@type": "Country", "name": "Colombia"},
        "sameAs": [
          "https://github.com/Lain-Sthid-Ramirez-Rueda",
          "https://www.linkedin.com/in/lain-sthid-ramirez-rueda",
          "https://wa.me/573209735859"
        ],
        "knowsAbout": ["Python","HTML Living Standard","CSS","Prompt Engineering","AI Automation","UI/UX Design","Requirements Elicitation","Git","Visual Studio Code","Subagentes de IA","Docker","Groq API","Claude AI","Gemini"],
        "email": "lainramirez18@gmail.com",
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "SENA",
          "url": "https://www.sena.edu.co"
        },
        "hasCredential": [
          {"@type": "EducationalOccupationalCredential", "name": "Diplomado Fundamentos de Full Stack", "credentialCategory": "Diplomado"},
          {"@type": "EducationalOccupationalCredential", "name": "Desarrollador Front-End", "credentialCategory": "Certificación"},
          {"@type": "EducationalOccupationalCredential", "name": "AI Certification", "credentialCategory": "Certificación", "recognizedBy": {"@type": "Organization", "name": "Anthropic"}}
        ]
      }
    </script>

    <!-- Explicit WebSite entity — separate from the Person schema above — so Google has a strong,
         unambiguous signal for the "site name" it shows in search results, instead of falling back to
         inferring it from the vercel.app hosting subdomain. -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Lain Sthid Ramirez Rueda | Portafolio",
        "url": "https://lainramirez.vercel.app/",
        "inLanguage": "es",
        "publisher": { "@type": "Person", "name": "Lain Sthid Ramirez Rueda" }
      }
    </script>

    <!-- Anti-flash theme init: applies the stored theme before first paint (dark stays the brand default) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('lain-theme-v2');
          document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        } catch {
          /* localStorage unavailable — keep the dark default already on <html> */
        }
      })();
    </script>

    <!-- Performance: preload critical resources -->
    <!-- Must match the first (highest-priority) <source> the <picture> in Hero.tsx actually picks
         (avif) — preloading .webp here while the browser loads .avif meant the preload went
         entirely unused, flagged by Lighthouse ("preloaded but not used within a few seconds"). -->
    <link rel="preload" href="/assets/img/profile.avif" as="image" fetchpriority="high" type="image/avif" />
    <!-- The LCP element (hero name) is set in Space Grotesk: preloading it lets the swap to the web
         font happen before the LCP candidate is finalized instead of after the CSS is parsed. -->
    <link rel="preload" href="/assets/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.vercel-insights.com" />
    <!-- Space Mono / DM Sans / Space Grotesk and Font Awesome are both self-hosted subsets
         (src/styles/fonts.css, src/styles/fontawesome.css, bundled via global.css) — no
         fonts.googleapis.com/fonts.gstatic.com or cdnjs.cloudflare.com dependency left. See
         docs/explanation-IA.md for the audit that moved these off Google's/cdnjs's CDNs
         (self-hosting the fonts alone removed a ~761ms render-blocking cross-origin request). -->
  </head>

  <body>
    <!-- Hydrates on the visitor's first interaction (src/directives/intent.ts): the page is fully
         pre-rendered, and hydrating the whole island up front was the main mobile TBT cost. -->
    <App client:intent />

    <!-- Vercel Web Analytics -->
    <script defer src="https://cdn.vercel-insights.com/v1/script.js" is:inline></script>
  </body>
</html>
